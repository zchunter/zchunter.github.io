        border-radius: 8px;
        padding: 1rem 1.1rem;
    }

    .at-a-glance-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem 1.25rem;
    }

    .at-a-glance-grid div {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .meta-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #6b7280;
    }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .gallery-hint {
        font-size: 0.88rem;
        color: #6b7280;
        margin: -0.25rem 0 0.9rem;
    }

