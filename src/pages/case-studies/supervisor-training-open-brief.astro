        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .case-header {
        margin-bottom: 2.5rem;
    }

    .eyebrow {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #3245ff;
        margin: 0 0 0.5rem;
    }

    .lead {
        font-size: 1.1rem;
        color: #6b7280;
        margin-top: -0.35rem;
    }

    section {
        margin-bottom: 1rem;
    }

    .section-divider {
        border: none;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        margin: 2.5rem 0;
    }

